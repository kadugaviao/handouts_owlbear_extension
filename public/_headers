# Política de cache para hospedagem estática (Cloudflare Pages, Netlify).
#
# O ponto crítico é o manifest.json: ele é o endereço que o Owlbear guarda para
# a extensão. Se for cacheado com agressividade, quem já instalou nunca recebe
# uma atualização — e o sintoma seria "atualizei e nada mudou".

/manifest.json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *

# Os nomes dos arquivos em /assets/ carregam hash do conteúdo: mudou o
# conteúdo, mudou o nome. Podem ser cacheados para sempre com segurança.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML não tem hash no nome: precisa revalidar para apontar aos assets novos.
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/pages/*
  Cache-Control: no-cache
